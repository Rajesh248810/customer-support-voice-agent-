# ==============================================================
# AI Customer Support Voice Agent - Environment Configuration
# ==============================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_secret_key_32chars

# Public Webhook URL (Domain or Ngrok/Tunnel URL reachable by Sarvam AI)
WEBHOOK_BASE_URL=https://your-domain.com

# Sarvam AI Instant Outbound Telephony Credentials
# Obtain these from: https://apps.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_ORG_ID=your_sarvam_org_id_here
SARVAM_WORKSPACE_ID=your_sarvam_workspace_id_here
SARVAM_APP_ID=salesbot-24888afc-8792
SARVAM_APP_VERSION=2
SARVAM_CONNECTION_ID=your_telephony_connection_id_here
SARVAM_AGENT_PHONE_NUMBER=+918000000000

# Voice Agent Defaults
DEFAULT_VOICE_NAME=ritu
DEFAULT_PRIMARY_LANGUAGE=hi-IN
DELIVERY_REVIEW_HOUR=20
CALL_LOCK_SECONDS=120

# Admin Dashboard Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_123
